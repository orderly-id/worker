{
  "schema_version": "1",
  "id": "wrk_01k2notes000000000000000001",
  "name": "Notes",
  "slug": "notes",
  "version": "0.1.0",
  "description": "Simpan dan kelola catatan dalam satu Worker Instance.",
  "publisher": {
    "name": "Orderly"
  },
  "assets": {
    "avatar": "assets/avatar.png"
  },
  "entry": "src/index.js",
  "instance": { "default_name": "notes" },
  "frontend": { "type": "schema", "entry": "workspace/schema.json" },
  "permissions": [
    "chat:read-current",
    "chat:write-current",
    "storage:read",
    "storage:write"
  ],
  "events": [
    "chat.message"
  ],
  "ai": {
    "provider": "platform",
    "system_prompt": "Anda adalah Worker Notes untuk satu instance spesifik. Pahami pesan berbahasa Indonesia atau Inggris dan gunakan konteks instance, pemilik, pengguna aktif, role, anggota, folder, serta catatan yang diberikan. Pilih satu aksi yang aman. Owner dan editor boleh membuat, mengganti nama, memindahkan, dan menghapus; guest hanya boleh membaca. Jangan mengarang note_id, folder_id, folder, pengguna, atau instance. Untuk create_note, pertahankan isi penting pengguna dan buat judul ringkas. Untuk rename, move, dan delete, pilih ID yang tepat dari konteks. Untuk pertanyaan atau daftar, jawab ringkas melalui field reply.",
    "action_schema": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["create_note", "create_folder", "rename_note", "delete_note", "move_note", "rename_folder", "delete_folder", "list_notes", "answer"] },
        "note_id": { "type": "string" },
        "folder_id": { "type": "string" },
        "title": { "type": "string" },
        "new_title": { "type": "string" },
        "content": { "type": "string" },
        "folder": { "type": "string" },
        "new_folder": { "type": "string" },
        "reply": { "type": "string" }
      },
      "required": ["action", "reply"]
    }
  },
  "data": {
    "models": [
      {
        "name": "notes",
        "fields": {
          "id": {
            "type": "uuid",
            "primary": true
          },
          "content": {
            "type": "text",
            "required": true
          },
          "title": { "type": "string", "required": true },
          "folder": { "type": "string", "required": true },
          "created_at": {
            "type": "datetime"
          }
        }
      }
    ]
  }
}
