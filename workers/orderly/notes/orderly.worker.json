{
  "schema_version": "1",
  "id": "wrk_01k2notes000000000000000001",
  "name": "Notes",
  "slug": "notes",
  "version": "0.3.0",
  "description": "Simpan dan kelola catatan melalui Assistant Chat atau Workspace instance.",
  "publisher": {
    "name": "Orderly"
  },
  "assets": {
    "avatar": "assets/avatar.png"
  },
  "entry": "src/index.js",
  "instance": { "default_name": "notes" },
  "frontend": { "type": "schema", "entry": "workspace/schema.json" },
  "permissions": [
    "chat:read-current",
    "chat:write-current",
    "storage:read",
    "storage:write"
  ],
  "events": [
    "chat.message"
  ],
  "ai": {
    "provider": "platform",
    "prompt_version": "1.0.0",
    "system_prompt_file": "prompts/system.md",
    "action_schema_file": "prompts/action.schema.json",
    "examples_file": "prompts/examples.json"
  },
  "data": {
    "models": [
      {
        "name": "folders",
        "fields": {
          "id": { "type": "uuid", "primary": true },
          "name": { "type": "string", "required": true },
          "position": { "type": "integer" },
          "important": { "type": "boolean" },
          "archived_at": { "type": "datetime" },
          "created_at": { "type": "datetime" }
        }
      },
      {
        "name": "notes",
        "fields": {
          "id": {
            "type": "uuid",
            "primary": true
          },
          "content": {
            "type": "text",
            "required": true
          },
          "title": { "type": "string", "required": true },
          "folder_id": { "type": "uuid", "required": true },
          "folder": { "type": "string", "required": true },
          "important": { "type": "boolean" },
          "archived_at": { "type": "datetime" },
          "created_at": {
            "type": "datetime"
          }
        }
      }
    ]
  }
}
