{
  "schema_version": "1",
  "id": "wrk_01k2notes000000000000000001",
  "name": "Notes",
  "slug": "notes",
  "version": "0.1.0",
  "description": "Simpan dan kelola catatan dalam satu Worker Instance.",
  "publisher": {
    "name": "Orderly"
  },
  "assets": {
    "avatar": "assets/avatar.png"
  },
  "entry": "src/index.js",
  "instance": { "default_name": "notes" },
  "frontend": { "type": "schema", "entry": "workspace/schema.json" },
  "permissions": [
    "chat:read-current",
    "chat:write-current",
    "storage:read",
    "storage:write"
  ],
  "events": [
    "chat.message"
  ],
  "ai": {
    "provider": "platform",
    "system_prompt": "Anda adalah Worker Notes. Pahami pesan berbahasa Indonesia atau Inggris. Pilih satu aksi yang aman. Jangan mengarang folder yang tidak tersedia. Untuk create_note, pertahankan isi penting pengguna dan buat judul ringkas. Untuk pertanyaan atau daftar, jawab ringkas melalui field reply.",
    "action_schema": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["create_note", "create_folder", "list_notes", "answer"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "folder": { "type": "string" },
        "reply": { "type": "string" }
      },
      "required": ["action", "reply"]
    }
  },
  "data": {
    "models": [
      {
        "name": "notes",
        "fields": {
          "id": {
            "type": "uuid",
            "primary": true
          },
          "content": {
            "type": "text",
            "required": true
          },
          "title": { "type": "string", "required": true },
          "folder": { "type": "string", "required": true },
          "created_at": {
            "type": "datetime"
          }
        }
      }
    ]
  }
}
